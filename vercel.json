      "destination": "https://github.com/smsabeidi/faangin/releases/download/v0.4.3/Faangin-0.4.3-arm64.dmg",
      "permanent": false
    },
    {
      "source": "/downloads/Faangin-0.4.3-Windows-x64-setup.exe",
      "destination": "https://github.com/smsabeidi/faangin/releases/download/v0.4.3/Faangin-0.4.3-Windows-x64-setup.exe",
